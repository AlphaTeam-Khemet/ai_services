# ──────────────────────────────────────────────────────────────
# KHEMET Hieroglyph Translator Service — environment variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── REQUIRED ──────────────────────────────────────────────────

# URL of the chatbot_LLM service (internal Docker network name).
# Change to http://localhost:8001 when running outside Docker.
LLM_SERVICE_URL=http://chatbot-llm:8001

# ── OPTIONAL ──────────────────────────────────────────────────

# Path to the YOLOv11 weights file (relative to /app inside the container).
# The file is mounted as a volume — do NOT bake it into the Docker image.
YOLO_MODEL_PATH=model/best_V2.pt

# Detection confidence threshold (0–1). Lower = more detections, more noise.
YOLO_CONF_THRESHOLD=0.35

# Port the uvicorn server listens on.
PORT=8002

# Comma-separated list of allowed CORS origins.
# Use * to allow all (default). Restrict in production.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
