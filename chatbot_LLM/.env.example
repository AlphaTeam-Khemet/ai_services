# ──────────────────────────────────────────────────────────────
# KHEMET Egyptian RAG Service — environment variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── REQUIRED ──────────────────────────────────────────────────

# Groq API Key for the LLM (get one free at https://console.groq.com)
GROQ_API_KEY=gsk_...

# ── OPTIONAL ──────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# Use * to allow all (default). Restrict in production.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Override the embedding model (default: BAAI/bge-m3)
# RAG_EMBEDDING_MODEL=BAAI/bge-m3

# Override the reranker model (default: BAAI/bge-reranker-v2-m3)
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Override the Groq LLM model (default: llama-3.3-70b-versatile)
# RAG_LLM_MODEL=llama-3.3-70b-versatile

# Override the ChromaDB collection name (default: egyptian_knowledge_bge_m3)
# RAG_COLLECTION_NAME=egyptian_knowledge_bge_m3
