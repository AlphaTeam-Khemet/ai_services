# ──────────────────────────────────────────────────────────────
# KHEMET CV Recognition Service — environment variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── OPTIONAL ──────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# Use * to allow all (default). Restrict in production.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# CLIP model to use for zero-shot classification.
# Smaller/faster alternative: openai/clip-vit-base-patch32
# CLIP_MODEL=openai/clip-vit-base-patch32

# HuggingFace model cache directory inside the container.
# Must match the volume mount in docker-compose.yml.
# HF_HOME=/app/models/huggingface

# Set to "production" to disable /docs and /redoc Swagger UI.
# ENV=production

# Log level for the service (default: INFO).
# LOG_LEVEL=INFO
