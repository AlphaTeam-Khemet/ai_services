# ──────────────────────────────────────────────────────────────
# KHEMET CV Recognition Service — environment variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── OPTIONAL ──────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# Use * to allow all (default). Restrict in production.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Override the model filename (default: model.h5).
# The file must exist inside the model/ directory.
# MODEL_FILENAME=model.h5

# Log level for the service (default: INFO).
# LOG_LEVEL=INFO
