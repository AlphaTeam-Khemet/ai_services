# ──────────────────────────────────────────────────────────────
# Voice Tour Guide — environment variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────

# ElevenLabs TTS API key (free at https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice IDs — must be [premade] voices on your ElevenLabs account.
# [professional] voices require a paid plan and will return HTTP 402.
# Confirmed free-tier premade voices for this project:
#   George (EN): JBFqnCBsd6RMkjVDRZzb  — "Warm, Captivating Storyteller"
#   Sarah  (AR): EXAVITQu4vr4xnSDxMaL  — "Mature, Reassuring, Confident"
ELEVENLABS_VOICE_EN=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_AR=EXAVITQu4vr4xnSDxMaL

# PostgreSQL connection URL — used to cache generated narrations per artifact.
# Inside Docker: host is the service name 'postgres'
DATABASE_URL=postgresql://postgres:your_db_password_here@postgres:5432/gem_museum

# ── OPTIONAL ──────────────────────────────────────────────────

# Port the uvicorn server listens on.
# PORT=8003

# Set to "production" to disable /docs and /redoc Swagger UI.
# ENV=production

# Log level for the service (default: INFO).
# LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
